# Adresa webu (bez lomítka na konci)
NEXT_PUBLIC_SITE_URL=https://vandr.world

# Odkazy do obchodů.
# Google Play: prázdné = https://play.google.com/store/apps/details?id=world.vandr.app (výchozí v kódu).
# App Store: dokud je prázdné, iPhone dostane místo tlačítka waiting list.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# Supabase (schéma "vandr"): waiting list pro iPhone, odhlášení, náhled pozvánky na /p/<kód>
# a čtení waiting listu v /admin. Bez těchto dvou proměnných běží web při vývoji v demo režimu
# (waiting list jen v paměti). V ostrém provozu na Vercelu jsou povinné, jinak zápis vrátí chybu.
SUPABASE_URL=https://xpikyrtjmueeyqrpfoox.supabase.co
# Settings > API Keys > Secret key (sb_secret_...). Nikdy ho nedávej do NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Tajný klíč pro otisk IP adresy (libovolný dlouhý náhodný text, např. openssl rand -base64 32).
# V ostrém provozu na Vercelu je povinný, bez něj zápis na waiting list vrátí chybu.
IP_HASH_SECRET=

# Uvítací e-mail waiting listu přes Resend (volitelné)
RESEND_API_KEY=
EMAIL_FROM=Vandr <ahoj@vandr.world>

# Správce osobních údajů (zobrazí se v zásadách)
# Buď jedním řádkem "Název | IČO | adresa", nebo tři samostatné proměnné.
NEXT_PUBLIC_CONTROLLER=
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_ID=
NEXT_PUBLIC_CONTROLLER_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=ahoj@vandr.world

# Microsoft Clarity (volitelné, načte se až po souhlasu)
NEXT_PUBLIC_CLARITY_ID=
