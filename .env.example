# Adresa webu (bez lomítka na konci)
NEXT_PUBLIC_SITE_URL=https://vandr.world

# Supabase: projekt cesta-dobrodruha, data Vandru jsou ve schématu "vandr"
# Bez těchto dvou proměnných běží web v demo režimu (data jen v paměti).
SUPABASE_URL=https://xpikyrtjmueeyqrpfoox.supabase.co
# Settings > API Keys > Secret key (sb_secret_...). Nikdy ho nedávej do NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Tajný klíč pro otisk IP adresy (libovolný dlouhý náhodný text)
IP_HASH_SECRET=

# Potvrzovací e-mail přes Resend (volitelné)
RESEND_API_KEY=
EMAIL_FROM=Vandr <ahoj@vandr.world>

# Správce osobních údajů (zobrazí se pod formulářem a v zásadách)
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_ID=
NEXT_PUBLIC_CONTROLLER_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=ahoj@vandr.world

# Výchozí nadpis a, b nebo c. AB_HEADLINE=on rozdělí návštěvy náhodně.
NEXT_PUBLIC_HEADLINE=a
AB_HEADLINE=off

# Microsoft Clarity (volitelné, načte se až po souhlasu)
NEXT_PUBLIC_CLARITY_ID=
